{
  "mcp_servers": [
    {
      "name": "context7",
      "command": "bunx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "40000"
      }
    },
    {
      "name": "sequential-thinking",
      "command": "bunx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    {
      "name": "clickup",
      "command": "bunx",
      "args": ["-y", "mcp-remote", "https://mcp.clickup.com/mcp"]
    }
  ],
